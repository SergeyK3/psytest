# Имена production-параметров. Реальные значения храните только в
# /etc/psytest/psytest.env с правами 600.

# Telegram Bot Token
# Получить можно у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key для генерации интерпретаций
# Получить можно на https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Drive service account. Credentials JSON is never stored in Git.
GOOGLE_APPLICATION_CREDENTIALS=/etc/psytest/google-drive-credentials.json
GOOGLE_DRIVE_FOLDER_ID=replace_with_shared_parent_folder_id
GOOGLE_DRIVE_LOCK_PATH=/var/lib/psytest/locks/google-drive-folders.lock

# Защищенная очередь полных отчетов при недоступности Google Drive.
PENDING_REPORTS_DIR=/var/lib/psytest/pending-reports
REPORT_WORK_DIR=/var/lib/psytest/work
