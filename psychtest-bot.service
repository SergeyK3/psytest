[Unit]
Description=Psychology Test Telegram Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=psychtest
Group=psychtest
WorkingDirectory=/opt/projects/psytest
EnvironmentFile=/etc/psytest/psytest.env
Environment=PYTHONPATH=/opt/projects/psytest
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MPLBACKEND=Agg
Environment=MPLCONFIGDIR=/var/lib/psytest/matplotlib
ExecStart=/opt/projects/psytest/.venv/bin/python3 /opt/projects/psytest/telegram_test_bot.py

# Политики перезапуска
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

StateDirectory=psytest/work psytest/pending-reports psytest/matplotlib psytest/locks
StateDirectoryMode=0700
ReadWritePaths=/var/lib/psytest/work
ReadWritePaths=/var/lib/psytest/pending-reports
ReadWritePaths=/var/lib/psytest/matplotlib
ReadWritePaths=/var/lib/psytest/locks

# Ограничения безопасности
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Ограничения ресурсов
MemoryMax=1G
CPUQuota=50%
TasksMax=100

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psychtest-bot

[Install]
WantedBy=multi-user.target
